                  "let prefix=\"0130\";\r\nlet min=1000000;\r\nlet max=9999999;\r\n\r\nlet randomNumber= Math.round(Math.random()*(max-min)+min);\r\n\r\nlet phoneNumber=prefix+randomNumber;\r\n\r\nconsole.log(phoneNumber)\r\npm.collectionVariables.set(\"customerPhoneNumber\", phoneNumber);\r\n\r\nlet gmailId=Math.round(Math.random()*(1000,9999)+1000);\r\npm.collectionVariables.set(\"customerGmailId\", gmailId);\r\n\r\n"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Verify user reg with duplicate email\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.message).to.contains(\"User already exists\");\r\n});"
